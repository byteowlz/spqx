{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Exact-audition curation save intent",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "bank",
    "audio_sha256",
    "expected_revision",
    "operation_id",
    "decision",
    "notes"
  ],
  "properties": {
    "bank": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "audio_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "expected_revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740990
    },
    "operation_id": {
      "type": "string",
      "pattern": "^[a-f0-9-]{36}$"
    },
    "decision": {
      "enum": [
        null,
        "keep",
        "reject",
        "unsure"
      ],
      "description": "null means no decision; unsure is deliberate uncertainty. Never a numeric score."
    },
    "notes": {
      "type": "string",
      "maxLength": 600
    }
  }
}
